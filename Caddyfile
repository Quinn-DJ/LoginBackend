{
	http_port 80
	https_port {$TASTYMAP_HTTPS_PORT:8443}
}

http://{$TASTYMAP_DOMAIN} {
	redir https://{$TASTYMAP_DOMAIN}:{$TASTYMAP_HTTPS_PORT}{uri} permanent
}

{$TASTYMAP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /api/* {
		reverse_proxy pocketbase:8090
	}

	respond 404

	log {
		output stdout
		format json
	}
}
